# Backend gateway URL. On a physical phone use your computer's LAN IP, not localhost.
# Android emulator: http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Only public, client-safe values belong here — EXPO_PUBLIC_* is bundled into the app.
# All third-party API keys live in backend/.env.
