# One .env for the whole project. Copy this file to .env (same folder) and fill it in.
#   - The backend reads every variable here.
#   - The app reads only EXPO_PUBLIC_API_URL (see frontend/app.config.js).
#     Never give a secret an EXPO_PUBLIC_ name: those values are sent to the app.

# ===================== Backend =====================

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Claude API (Prediction Engine) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Supabase / PostgreSQL ---
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI)
# Use the asyncpg driver prefix: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- External APIs ---
GOOGLE_PLACES_API_KEY=
ZOCDOC_CLIENT_ID=
ZOCDOC_CLIENT_SECRET=
GOODRX_API_KEY=
GOODRX_SECRET_KEY=
# RxNav (NLM) is free and needs no key
# openFDA key is optional (raises rate limit)
OPENFDA_API_KEY=

# --- Telehealth: Twilio and/or Agora ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ===================== Frontend (public) =====================

# Backend URL the app calls. On a physical phone use your computer's local IP, not localhost
# (e.g. http://192.168.1.20:8000/api/v1). Android emulator: http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
